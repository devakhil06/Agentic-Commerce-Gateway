# Copy to .env; never commit .env. All currencies are INR and API amounts are paise.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./gateway.db
REDIS_URL=
# Required outside development. Generate with scripts/generate-secrets.py.
SECRET_KEY=
ENCRYPTION_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
AI_TIMEOUT_SECONDS=15
# Prefer workspace-specific encrypted credentials configured through Integrations.
# These environment fallbacks work only in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000
